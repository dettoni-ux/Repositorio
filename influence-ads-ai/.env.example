# ── Base ─────────────────────────────────────────────────────────────
# URL pública de la app (se usa para el callback OAuth de Meta)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://ia:ia_local@localhost:5432/influence_ads
# Clave maestra de cifrado (32 bytes en base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Directorio para creatividades y archivos subidos (fuera del repo en producción)
STORAGE_DIR=./storage

# ── Meta (app en developers.facebook.com, tipo Empresa) ──────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Opcional: configuración de Facebook Login for Business (config_id)
META_LOGIN_CONFIG_ID=

# ── IA ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Generación de imágenes (Replicate). Sin token, el laboratorio funciona solo con fotos subidas.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
